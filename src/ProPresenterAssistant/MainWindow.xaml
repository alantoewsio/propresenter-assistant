<Window x:Class="ProPresenterAssistant.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ProPresenter Assistant" Icon="Assets/app-icon.ico" Background="#10131B" Foreground="#F1F2F8" FontFamily="Segoe UI" FontSize="14" Width="1160" Height="800" MinWidth="950" MinHeight="650" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="WindowDrop">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PROPRESENTER ASSISTANT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Accent}"/><TextBlock Text="From drive to presentation." FontSize="28" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Resume import" Click="ResumeClick"/><Button Content="Settings" Click="SettingsClick"/></StackPanel></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Panel}" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="YOUR WORKFLOW" FontSize="11" Foreground="#9AA5BE" FontWeight="Bold" Margin="0,0,0,22"/><TextBlock Text="1    Find your media" Margin="0,0,0,20"/><TextBlock Text="2    Choose and select" Margin="0,0,0,20"/><TextBlock Text="3    Name and import" Margin="0,0,0,28"/><Separator Background="#374158" Margin="0,0,0,20"/><TextBlock Text="DESTINATION PLAYLIST" FontSize="11" Foreground="#9AA5BE" FontWeight="Bold"/><ComboBox x:Name="PlaylistBox" DisplayMemberPath="Name" SelectionChanged="PlaylistChanged" DropDownOpened="PlaylistOpened" IsEnabled="False"/><TextBlock x:Name="ConnectionText" Text="Checking ProPresenter…" Foreground="#9AA5BE" TextWrapping="Wrap"/><Button x:Name="LaunchProPresenterButton" Content="Launch ProPresenter" Click="LaunchProPresenterClick" Visibility="Collapsed" Margin="0,12,0,0"/><TextBlock Text="LOCAL MEDIA FOLDER" FontSize="11" Foreground="#9AA5BE" FontWeight="Bold" Margin="0,26,0,8"/><TextBlock x:Name="FolderText" Foreground="#9AA5BE" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
   <Grid Grid.Column="2">
    <Border x:Name="WelcomePanel" Background="{StaticResource Panel}" CornerRadius="14" Padding="40"><StackPanel VerticalAlignment="Center"><TextBlock Text="Bring your media along." FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Connect a USB drive, drop files here, or choose a folder. We’ll find images and videos, including those inside archives." TextWrapping="Wrap" Foreground="#ABB5CC" FontSize="16" Margin="0,18,0,28"/><StackPanel Orientation="Horizontal"><Button Content="Choose files" Background="{StaticResource Accent}" Foreground="#10131B" Click="FilesClick"/><Button Content="Choose folder" Click="FolderClick"/></StackPanel><TextBlock x:Name="MonitorText" Text="USB monitoring is on • Runs quietly in your system tray" TextWrapping="Wrap" Foreground="#9AA5BE" Margin="4,28,0,0"/></StackPanel></Border>
    <Grid x:Name="SelectionPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Choose what goes into this item." FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="SelectionText" Foreground="#9AA5BE" Margin="0,8,0,10"/></StackPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Select all" Click="SelectAllClick" Padding="12,8"/><Button Grid.Column="1" Content="Clear" Click="ClearClick" Padding="12,8"/><ComboBox x:Name="FilterBox" Grid.Column="2" SelectionChanged="FilterChanged" Width="110" Margin="8,4" SelectedIndex="0"><ComboBoxItem Content="All media"/><ComboBoxItem Content="Images"/><ComboBoxItem Content="Videos"/></ComboBox><TextBox x:Name="SearchBox" Grid.Column="3" TextChanged="SearchChanged" Margin="8,4" ToolTip="Search filenames or folders"/></Grid>
     <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"><ItemsControl x:Name="MediaGrid"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Checked="SelectionChanged" Unchecked="SelectionChanged" Margin="0,0,12,14" VerticalContentAlignment="Top"><Border Background="{StaticResource Panel}" CornerRadius="10" Width="206" Padding="10"><StackPanel><Grid Height="116" Background="#0B0E15"><TextBlock Text="Preview" Foreground="#536078" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Thumbnail}" Stretch="Uniform"/><Border Background="#B010131B" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="Bold"/></Border></Grid><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="0,10,0,3" ToolTip="{Binding Name}"/><TextBlock Text="{Binding Detail}" Foreground="#ABB5CC" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/><TextBlock Text="{Binding Location}" TextTrimming="CharacterEllipsis" Foreground="#7D8AA7" FontSize="11" Margin="0,4,0,0" ToolTip="{Binding Location}"/></StackPanel></Border></CheckBox></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
     <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="Previous" Click="PreviousClick"/><TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="12,0"/><Button Content="Next page" Click="NextPageClick"/></StackPanel>
    </Grid>
    <Border x:Name="ReviewPanel" Visibility="Collapsed" Background="{StaticResource Panel}" CornerRadius="14" Padding="36"><StackPanel><TextBlock Text="Give this item a name." FontSize="27" FontWeight="SemiBold"/><TextBlock Text="One new presentation, with one slide per selected image or video." Foreground="#ABB5CC" TextWrapping="Wrap" Margin="0,12,0,28"/><TextBlock Text="PRESENTATION NAME" FontSize="12" Foreground="#9AA5BE"/><TextBox x:Name="NameBox" FontSize="22" MaxLength="100" TextChanged="NameChanged"/><TextBlock x:Name="ReviewText" TextWrapping="Wrap" FontSize="16" Margin="0,14,0,20"/><TextBlock Text="Files are stored on this computer. Slides are sorted alphabetically by filename. Your USB drive can be removed after completion." Foreground="#ABB5CC" TextWrapping="Wrap"/><TextBlock Text="If ProPresenter asks which library to use, choose one there to finish the native import." Foreground="#9AA5BE" TextWrapping="Wrap" Margin="0,24,0,0"/></StackPanel></Border>
    <Border x:Name="BusyPanel" Visibility="Collapsed" Background="{StaticResource Panel}" CornerRadius="14" Padding="40"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="BusyTitle" Text="Getting things ready…" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="BusyText" Foreground="#ABB5CC" TextWrapping="Wrap" Margin="0,20,0,22"/><ProgressBar x:Name="Progress" Height="8" Maximum="100" Foreground="{StaticResource Accent}"/><TextBlock Text="You can cancel. Prepared files are retained if the ProPresenter import needs to be resumed." Foreground="#9AA5BE" TextWrapping="Wrap" Margin="0,22,0,0"/></StackPanel></Border>
    <Border x:Name="DonePanel" Visibility="Collapsed" Background="{StaticResource Panel}" CornerRadius="14" Padding="40"><StackPanel VerticalAlignment="Center"><TextBlock Text="Ready in ProPresenter." FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock x:Name="DoneText" FontSize="17" TextWrapping="Wrap" Margin="0,20,0,25"/><Button Content="Open imported media folder" HorizontalAlignment="Left" Click="OpenFolderClick"/></StackPanel></Border>
   </Grid>
  </Grid>
  <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready when you are." Foreground="#9AA5BE" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/><Button x:Name="BackButton" Grid.Column="1" Content="Back" Click="BackClick" Visibility="Collapsed"/><Button x:Name="NextButton" Grid.Column="2" Content="Review selection →" Click="NextClick" Visibility="Collapsed" Background="{StaticResource Accent}" Foreground="#10131B" FontWeight="SemiBold"/></Grid>
 </Grid>
</Window>
